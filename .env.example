# Copy this file to .env and replace both values with secure random values.
# Example: openssl rand -base64 36
MSSQL_SA_PASSWORD=replace_with_a_strong_sql_server_password
SERENA_JWT_KEY=replace_with_at_least_32_random_bytes

SERENA_JWT_ISSUER=Serena
SERENA_JWT_AUDIENCE=Serena

# Gmail SMTP. Create a Google App Password (requires 2-Step Verification)
# and enter it as SERENA_SMTP_PASSWORD in your local, git-ignored .env file.
SERENA_SMTP_HOST=smtp.gmail.com
SERENA_SMTP_PORT=587
SERENA_SMTP_USERNAME=serenaadsosoporte@gmail.com
SERENA_SMTP_PASSWORD=
SERENA_SMTP_FROM=serenaadsosoporte@gmail.com
SERENA_SMTP_DISPLAY_NAME=SERENA
SERENA_SMTP_ENABLE_SSL=true
